{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,

    "strict": false,
    "strictNullChecks": true,

    /* No `paths`, no `baseUrl`: package sources resolve by relative path only.
       An `@/`-style alias here would be a silent coupling to whatever host
       happens to define it, `package-purity.test.ts` fails the build if one
       ever appears in this tree. */
    "types": []
  },
  "include": ["src"]
}
