# Blobbi Island: build-time environment example.
#
# Copy values you need into an uncommitted `.env.local`, then FULLY restart
# Vite: build-time variables are baked in at server/build start, and hot
# reload cannot change them.

# Enables the real signed Inventory & Equipment Lab
# (/tools/game-items → Equipment Lab), which publishes REAL kind:31633 and
# kind:31634 events for the logged-in account.
# Off by default. Development/operator use only. Only the exact string "true"
# enables it. See docs/inventory-equipment-lab.md.
VITE_ENABLE_LIVE_INVENTORY_LAB=false
