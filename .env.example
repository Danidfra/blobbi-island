# Blobbi Island: build-time environment example.
#
# Copy values you need into an uncommitted `.env.local`, then FULLY restart
# Vite: build-time variables are baked in at server/build start, and hot
# reload cannot change them.

# Enables the real signed Inventory & Equipment Lab
# (/tools/game-items → Equipment Lab), which publishes REAL kind:31633 and
# kind:31634 events for the logged-in account.
# Off by default. Development/operator use only. Only the exact string "true"
# enables it. See docs/inventory-equipment-lab.md.
VITE_ENABLE_LIVE_INVENTORY_LAB=false

# World Travel on Nostr (src/worlds, docs/world-travel.md): the Blobbi's
# World Location (kind 31126, experimental) read from and written to the
# public travel relays, shared with Blobbi Home and Blobbi Pixel. Off by
# default: navigation to the other worlds still works, but nothing about
# WHERE the Blobbi is is read, signed or published. Only the exact string
# "nostr" turns it on; any other value stops the build. The owner's release
# decision. On a development server, `localStorage['blobbi:world-travel:v1']
# = 'nostr'` turns it on for that page instead.
# VITE_BLOBBI_WORLD_TRAVEL=nostr

# Point a world's door at a local or staging deployment (an absolute https
# address; anything else is ignored and the registry's checked address
# stands). One per world id: HOME, PIXEL, FARM, RUMBLE.
# VITE_BLOBBI_WORLD_URL_PIXEL=https://pixel-staging.example/
